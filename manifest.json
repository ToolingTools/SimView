{
  "manifest_version": "0.3",
  "name": "simview",
  "display_name": "SimView",
  "version": "0.1.11",
  "description": "Control and review a local iOS Simulator.",
  "long_description": "A local-only iOS Simulator preview with physical input and review annotations.",
  "author": {
    "name": "SimView contributors"
  },
  "homepage": "https://github.com/ToolingTools/SimView",
  "documentation": "https://github.com/ToolingTools/SimView#readme",
  "support": "https://github.com/ToolingTools/SimView/issues",
  "icon": "assets/icon.png",
  "server": {
    "type": "binary",
    "entry_point": "bin/simview",
    "mcp_config": {
      "command": "${__dirname}/bin/simview",
      "args": ["mcp"]
    }
  },
  "compatibility": {
    "platforms": ["darwin"]
  }
}
