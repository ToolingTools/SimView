{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/.claude",
      "!!**/.codex",
      "!!**/.simview",
      "!!**/artifacts",
      "!!**/coverage",
      "!!**/graphify-out",
      "!!**/node_modules",
      "!!**/native/SimViewCore/.build",
      "!!**/native/SimViewProbe/build",
      "!!**/packages/*/dist",
      "!!**/packages/core/bin"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["packages/app/src/preview.html"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          },
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
