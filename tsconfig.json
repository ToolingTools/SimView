{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "types": ["bun"],
    "paths": {
      "@simview/core": ["./packages/core/src/index.ts"],
      "@simview/contracts": ["./packages/contracts/src/index.ts"],
      "@simview/client": ["./packages/client/src/index.ts"],
      "@simview/mcp": ["./packages/mcp/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "scripts/**/*.ts", "tests/**/*.ts"]
}
